{
  "name": "@k-brother/synapse",
  "version": "1.0.0",
  "description": "Multi-platform AI bridge (Feishu, Telegram, WeCom, DingTalk) with MCP server support — Claude Code superpower",
  "repository": {
    "type": "git",
    "url": "https://github.com/k-brother/synapse.git"
  },
  "homepage": "https://github.com/k-brother/synapse",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "synapse": "dist/cli.js"
  },
  "files": [
    "dist",
    ".env.example",
    "config.example.json",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "synapse",
    "claude",
    "claude-code",
    "mcp",
    "feishu",
    "lark",
    "telegram",
    "wecom",
    "dingtalk",
    "bot",
    "bridge",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@wecom/aibot-node-sdk": "^1.0.1",
    "dingtalk-stream": "^2.1.6-beta.1",
    "telegraf": "^4.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
